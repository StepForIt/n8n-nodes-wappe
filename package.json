{
	"name": "n8n-nodes-wappe",
	"version": "0.9.2",
	"description": "n8n nodes for Wappe, the WhatsApp CRM & automation platform: send messages, manage contacts and groups, and react to WhatsApp events.",
	"license": "MIT",
	"homepage": "https://github.com/StepForIt/n8n-nodes-wappe#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"wappe",
		"whatsapp",
		"crm"
	],
	"author": {
		"name": "Step For It",
		"email": "mathieu@stepforit.fr"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/StepForIt/n8n-nodes-wappe.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test \"test/*.test.mjs\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/WappeApi.credentials.js",
			"dist/credentials/WappeOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Wappe/Wappe.node.js",
			"dist/nodes/WappeTrigger/WappeTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.49.1",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
